# eval outputs (videos are large) — keep only small metrics under results/
eval_logs/
*.mp4

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# training / experiment junk
wandb/
outputs/
*.log

# LC-Flow run directories: adapters/optimizers are GBs and reproducible from
# the locked contracts + hashes recorded in the committed audit JSONs.
# Small metrics (training_summary.json, *_audit.json, closed_loop_*.json)
# stay visible for explicit commits.
results/**/epoch_*/
results/**/optimizer_latest.pt
results/**/*.safetensors

# Large generated experiment trees. Keep compact configs, manifests, metrics,
# summaries, and audit reports visible while excluding tensors/caches/rollouts.
results/**/hcache/
results/**/train/
results/**/checkpoints/
results/**/shards/
results/**/sources/
results/**/teacher_banks/
results/**/teacher_sources/
results/**/acquire_sources/
results/**/prospective_sources/
results/**/physical_transitions/
results/**/traces/

# Binary model/data artifacts are stored outside Git. Existing tracked files
# remain tracked; these rules prevent newly generated artifacts from surfacing.
results/**/*.pt
results/**/*.pth
results/**/*.ckpt
results/**/*.npz
results/**/*.npy

# High-volume generated indexes/ledgers; retain their compact reports/manifests.
results/**/hcache_index.json
results/**/recovery_ledger.jsonl
# Preserved prior versions of those indexes (scripts/build_v075_hcache.py
# `preserve_and_write`). They live on disk so a run that trained against an
# index keeps an exact input identity; the compact append-only audit trail
# `index_lineage.jsonl` is what gets committed.
results/**/index_archive/

# external source (installed editable into vf0s, lives at ../lerobot)
/lerobot/
results/**/checkpoint_epoch*.pt
results/**/wz_step*.pt
results/**/*.tmp

# Per-frame RGB dumps from tape replays and perception probes (v242-v248).
# The committed manifest.jsonl carries a sha256 per frame, so a dump is
# reproducible from the replay script and verifiable against the manifest.
results/**/images/
results/**/overlays/
results/**/t0_overlays/

# Per-frame teacher/probe label dumps. A dump may be ignored only where the
# producer_source.py that regenerates it is committed beside it (18 such runs
# under v244/v245/v247). The compact result.json / COMPLETE.json /
# episode_summaries stay tracked.
results/**/labels.jsonl
results/**/labels_by_manifest/
results/**/frames.jsonl

# Exceptions: these 10 runs have NO producer_source.py on disk, so the
# "regenerable" justification above is false for them and the dump is the only
# copy of the evidence. Seven are hash-pinned by a committed certificate
# (COMPLETE.json labels_sha256; for chain3_ep16_95_frozen_v1 also
# results/v243_sam2_teacher_gate/chain3_ep16_95_frozen_v1/GATE.json
# teacher_artifacts[0].labels_sha256 = 7885463b...b4ab4b7, the sealed STOP cited
# at plan_and_progress/2026-09-01.md:299). The three v242 runs are pinned by
# nothing and have no other tracked file, so ignoring them would erase the run.
# No parent directory of these paths is excluded, so the negations take effect.
!results/v242_qwen_progress/chain3_ep0_prompt2_2026-09-01T2348Z/labels.jsonl
!results/v242_qwen_progress/chain3_ep0_prompt3_2026-09-01T2354Z/labels.jsonl
!results/v242_qwen_progress/chain3_ep0_smoke_2026-09-01T2341Z/labels.jsonl
!results/v243_sam2_teacher/chain3_ep0_calibration_v1/labels.jsonl
!results/v243_sam2_teacher/chain3_ep16_95_frozen_v1/labels.jsonl
!results/v243_sam2_teacher/chain3_ep16_frozen_v1/labels.jsonl
!results/v244_t0_initializer/dinov2_points_nine_full_v1/labels.jsonl
!results/v244_t0_initializer/fixed_points_ep16_95_full_v1/labels.jsonl
!results/v244_t0_initializer/fixed_points_nine_full_v1/labels.jsonl
!results/v244_t0_initializer/fixed_points_nine_t0_v1/labels.jsonl
