# eval outputs (videos are large) — keep only small metrics under results/
eval_logs/
*.mp4

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# training / experiment junk
wandb/
outputs/
*.log

# LC-Flow run directories: adapters/optimizers are GBs and reproducible from
# the locked contracts + hashes recorded in the committed audit JSONs.
# Small metrics (training_summary.json, *_audit.json, closed_loop_*.json)
# stay visible for explicit commits.
results/**/epoch_*/
results/**/optimizer_latest.pt
results/**/*.safetensors

# Large generated experiment trees. Keep compact configs, manifests, metrics,
# summaries, and audit reports visible while excluding tensors/caches/rollouts.
results/**/hcache/
results/**/train/
results/**/checkpoints/
results/**/shards/
results/**/sources/
results/**/teacher_banks/
results/**/teacher_sources/
results/**/acquire_sources/
results/**/prospective_sources/
results/**/physical_transitions/
results/**/traces/

# Binary model/data artifacts are stored outside Git. Existing tracked files
# remain tracked; these rules prevent newly generated artifacts from surfacing.
results/**/*.pt
results/**/*.pth
results/**/*.ckpt
results/**/*.npz
results/**/*.npy

# High-volume generated indexes/ledgers; retain their compact reports/manifests.
results/**/hcache_index.json
results/**/recovery_ledger.jsonl

# external source (installed editable into vf0s, lives at ../lerobot)
/lerobot/
results/**/checkpoint_epoch*.pt
results/**/wz_step*.pt
results/**/*.tmp
